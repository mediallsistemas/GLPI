GLPI_API_URL=https://glpi.suaempresa.com.br/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Assina o cookie de sessão do painel. Gere com: openssl rand -base64 48
SESSAO_SEGREDO=

# Logins do GLPI que administram o painel: sempre entram e liberam os demais na tela Usuários.
# Separe por vírgula. Sem isso ninguém consegue liberar o primeiro acesso.
PAINEL_ADMINISTRADORES=

# Grupo do GLPI cujos membros podem entrar no painel. Criado automaticamente na primeira liberação.
GLPI_GRUPO_PAINEL=Painel de chamados
