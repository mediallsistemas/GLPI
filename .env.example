GLPI_API_URL=https://glpi.suaempresa.com.br/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Assina o cookie de sessão do painel. Gere com: openssl rand -base64 48
SESSAO_SEGREDO=

# Logins do GLPI que administram o painel: sempre entram e bloqueiam os demais na tela Usuários.
# Separe por vírgula.
PAINEL_ADMINISTRADORES=

# Grupo do GLPI cujos membros NÃO podem entrar no painel. Criado automaticamente no primeiro bloqueio.
GLPI_GRUPO_BLOQUEADOS=Painel de chamados - bloqueados
